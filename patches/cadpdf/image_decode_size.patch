@@ -58,6 +58,32 @@
   return safe_val.ValueOrDefault(kLimit) >= kLimit;
 }
 
+// CadPDF E2: the number of device pixels one image axis spans, `unit` being
+// the length of that axis in device space. NaN and values below 1 give 1.
+int ImageAxisDevicePixels(float unit) {
+  static constexpr float kMax = 1024.0f * 1024.0f * 1024.0f;
+  if (!(unit > 1.0f)) {
+    return 1;
+  }
+  return unit >= kMax ? static_cast<int>(kMax) : static_cast<int>(ceilf(unit));
+}
+
+// CadPDF E2: true when the image stream's last filter is DCTDecode or
+// JPXDecode, i.e. the image is decoded by libjpeg or OpenJPEG, both of which
+// decode at a reduced size chosen from the size required.
+bool IsDCTOrJPXImage(const CPDF_ImageObject* image_object) {
+  RetainPtr<const CPDF_Stream> stream = image_object->GetImage()->GetStream();
+  if (!stream) {
+    return false;
+  }
+  std::optional<DecoderArray> decoders = GetDecoderArray(stream->GetDict());
+  if (!decoders.has_value() || decoders.value().empty()) {
+    return false;
+  }
+  const ByteString& last = decoders.value().back().first;
+  return last == "DCTDecode" || last == "JPXDecode";
+}
+
 }  // namespace
 
