+  // at x10). Other codecs keep the device size.
+  CFX_Size max_size_required(render_status_->GetRenderDevice()->GetWidth(),
+                             render_status_->GetRenderDevice()->GetHeight());
+  if (IsDCTOrJPXImage(image_object_)) {
