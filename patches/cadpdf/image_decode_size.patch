+// CadPDF E2: the number of device pixels one image axis spans, `unit` being
+// the length of that axis in device space. NaN and values below 1 give 1.
+int ImageAxisDevicePixels(float unit) {
+  static constexpr float kMax = 1024.0f * 1024.0f * 1024.0f;
+  if (!(unit > 1.0f)) {
+    return 1;
+  }
+  return unit >= kMax ? static_cast<int>(kMax) : static_cast<int>(ceilf(unit));
+}
+
+// CadPDF E2: true when the image stream's last filter is DCTDecode, i.e. the
+// image is decoded by libjpeg.
+bool IsDCTImage(const CPDF_ImageObject* image_object) {
+  RetainPtr<const CPDF_Stream> stream = image_object->GetImage()->GetStream();
+  if (!stream) {
+    return false;
+  }
+  std::optional<DecoderArray> decoders = GetDecoderArray(stream->GetDict());
+  return decoders.has_value() && !decoders.value().empty() &&
+         decoders.value().back().first == "DCTDecode";
+}
