+bool CPDF_Creator::CreateIncrementalTail(
+    const std::vector<uint32_t>& extra_obj_nums) {
+  if (id_array_) {
+    return false;  // Create() or CreateIncrementalTail() already ran.
+  }
+  // Every refusal below guards against output that is not a valid update
+  // section for the file the document was loaded from.
+  if (!parser_ || encrypt_dict_ || security_handler_ ||
+      parser_->xref_table_rebuilt() || parser_->GetLastXRefOffset() <= 0) {
+    return false;
+  }
+  const FX_FILESIZE base_offset = parser_->GetDocumentSize();
+  if (base_offset <= 0) {
+    return false;
+  }
+
+  const uint32_t last_file_obj_num = parser_->GetLastObjNum();
+  std::vector<uint32_t> obj_nums;
+  for (const auto& pair : *document_) {
+    if (pair.first > last_file_obj_num && pair.second &&
+        pair.second->GetObjNum() != CPDF_Object::kInvalidObjNum) {
+      obj_nums.push_back(pair.first);
+    }
+  }
+  for (uint32_t objnum : extra_obj_nums) {
+    // Never parse here: an object that is not loaded was not modified.
+    RetainPtr<const CPDF_Object> obj = document_->GetIndirectObject(objnum);
+    if (!obj) {
+      return false;
+    }
+    // Objects are written with generation 0; references to a non-zero
+    // generation in the file would stop resolving.
+    if (obj->GetGenNum() != 0) {
+      return false;
+    }
+    obj_nums.push_back(objnum);
+  }
+  std::sort(obj_nums.begin(), obj_nums.end());
+  obj_nums.erase(std::unique(obj_nums.begin(), obj_nums.end()),
+                 obj_nums.end());
+  if (obj_nums.empty()) {
+    return false;
+  }
+
+  static_cast<FileBufferArchive*>(archive_.get())->SetBaseOffset(base_offset);
+  tail_only_ = true;
+  is_incremental_ = true;
+  is_original_ = false;
+  subset_new_fonts_ = false;
+  stage_ = Stage::kInit0;
+  last_obj_num_ = document_->GetLastObjNum();
+  object_offsets_.clear();
+  new_obj_num_array_ = std::move(obj_nums);  // Sorted, ascending.
+
+  InitID();
+  if (!Continue()) {
+    return false;
+  }
+  // WriteNewObjs() skips objects it cannot find; a skipped one would leave a
+  // dangling reference, so every listed object must have been written.
+  for (uint32_t objnum : new_obj_num_array_) {
+    if (!pdfium::Contains(object_offsets_, objnum)) {
+      return false;
+    }
+  }
+  // Classic cross-reference entries are printed with "%010d".
+  return archive_->CurrentOffset() <= std::numeric_limits<int32_t>::max();
+}
