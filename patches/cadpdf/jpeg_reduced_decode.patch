 pdfium::span<uint8_t> LibjpegScanlineDecoder::GetNextLine() {
+  // CadPDF E1: the last output row of a reduced decode with a partial edge
+  // block is spoiled (see InitDecode()). It is read into a scratch buffer and
+  // the previous row, still in `scanline_buf_`, is returned in its place.
+  // InitDecode() guarantees at least two output rows when this applies.
+  const bool replace_row =
+      orig_height_ % scale_denom_ != 0 &&
+      common_.cinfo.output_scanline + 1 == common_.cinfo.output_height;
+  if (replace_row) {
+    DataVector<uint8_t> scratch(pitch_);
+    uint8_t* scratch_array[] = {scratch.data()};
+    if (jpeg_common_read_scanlines(&common_, scratch_array, 1u) <= 0) {
+      return pdfium::span<uint8_t>();
+    }
+    return scanline_buf_;
+  }
   uint8_t* row_array[] = {scanline_buf_.data()};
   int nlines = jpeg_common_read_scanlines(&common_, row_array, 1u);
   if (nlines <= 0) {
     return pdfium::span<uint8_t>();
   }
+  // CadPDF E1: the last output column likewise; copy its left neighbour. Both
+  // offsets lie inside the bytes libjpeg has just written.
+  if (orig_width_ % scale_denom_ != 0) {
+    const size_t bytes_per_pixel =
+        static_cast<size_t>(common_.cinfo.output_components);
+    const size_t last = static_cast<size_t>(common_.cinfo.output_width) - 1;
+    for (size_t i = 0; i < bytes_per_pixel; ++i) {
+      scanline_buf_[last * bytes_per_pixel + i] =
+          scanline_buf_[(last - 1) * bytes_per_pixel + i];
+    }
+  }
   return scanline_buf_;
 }
 
